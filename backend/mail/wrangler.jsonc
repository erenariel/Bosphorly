{
  "name": "bosphorly-transfer-mail",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": false},
  "vars": {
    "PUBLIC_ORIGIN": "https://bosphorly.com",
    "ENABLE_EMAIL_REQUESTS": "true",
    "REQUEST_FROM_EMAIL": "Bosphorly Travel <requests@notify.bosphorly.com>"
  },
  "ratelimits": [
    {"name":"RATE_LIMITER","namespace_id":"1047","simple":{"limit":10,"period":60}}
  ]
}
